{
  "name": "image-minify",
  "version": "1.0.0",
  "description": "Minify Image",
  "homepage": "https://github.com/mishraabhishek11/image-minify#readme",
  "bugs": {
    "url": "https://github.com/mishraabhishek11/image-minify/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mishraabhishek11/image-minify.git"
  },
  "license": "MIT",
  "author": "Abhishek Mishra",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dev": "nodemon --exec electron .",
    "package-mac": "electron-packager . --overwrite --platform=darwin --arch=x64 --icon=assets/icons/mac/icon.icns --prune=true --out=release-builds",
    "package-win": "electron-packager . --overwrite --platform=win32 --arch=ia32 --icon=assets/icons/win/icon.ico --prune=false --out=release-builds --version-string.CompanyName=CE --version-string.FileDescription=CE --version-string.ProductName=\"MinifyImage\"",
    "package-linux": "electron-packager . --overwrite --platform=linux --arch=x64 --icon=assets/icons/png/1024x1024.png --prune=false --out=release-builds"
  },
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-packager": "^17.1.2",
    "nodemon": "^3.1.14"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "imagemin": "^9.0.1",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^10.0.0",
    "slash": "^5.1.0"
  }
}
